# Ekipon - environment template. Copy to .env and fill with real values.
# .env is git-ignored; this file is safe to commit.

# --- Store ---
WC_STORE_URL=https://your-store.example

# --- WooCommerce REST API (WooCommerce > Settings > Advanced > REST API) ---
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WordPress (media upload via Application Password) ---
WP_USER=your_wp_user
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# --- Site access lock (maintenance / coming-soon gate), if any ---
SITE_LOCK_USER=
SITE_LOCK_PASS=

# --- ElevenLabs (voz en off, musica de fondo, forced alignment de subtitulos) ---
# Usado por voz_en_off.py, musica.py y subtitulos.py. Faltaba en este archivo
# de ejemplo pese a ser obligatorio para esos tres modulos -- agregado junto
# con ANTHROPIC_API_KEY al construir el orquestador (Fase 1).
ELEVENLABS_API_KEY=

# --- Anthropic (redactor_ia.py: guion de voz + prompt de musica con IA) ---
# Opcional: si falta, el orquestador degrada solo al recorte automatico de
# la descripcion de la ficha y a un prompt de musica generico fijo.
ANTHROPIC_API_KEY=
