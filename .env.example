# Ekipon — environment template. Copy to .env and fill with real values.
# .env is git-ignored; this file is safe to commit.

# --- Store ---
WC_STORE_URL=https://your-store.example

# --- WooCommerce REST API (WooCommerce > Settings > Advanced > REST API) ---
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WordPress (media upload via Application Password) ---
WP_USER=your_wp_user
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# --- Site access lock (maintenance / coming-soon gate), if any ---
SITE_LOCK_USER=
SITE_LOCK_PASS=
